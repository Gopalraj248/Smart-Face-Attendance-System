# ==========================================
# Smart Face Attendance System - Example Configuration
# Copy this file to .env and configure your custom settings
# ==========================================

# Admin Security PIN (Required to enroll new faces & access attendance records)
ADMIN_PIN=1234

# Camera Device Index (0 for default built-in webcam, 1 or 2 for external USB webcam)
CAMERA_INDEX=0

# Minimum minutes before exit punch can be registered for the same user today
MIN_MINUTES_BEFORE_EXIT=1

# Eye Aspect Ratio (EAR) Blink Detection Threshold
EYE_ASPECT_RATIO_THRESHOLD=0.30

# Number of consecutive frames eyes must be closed to register a valid blink
EYE_ASPECT_RATIO_CONSEC_FRAMES=2

# Anti-spam cooldown in seconds
PUNCH_COOLDOWN_SECONDS=8

# Duration (in video frames) to display feedback banner
FEEDBACK_DURATION=40

# AI frame skipping interval (2 for 30+ FPS)
FRAME_PROCESS_INTERVAL=2

# Cache file path
CACHE_FILE=encodings_cache.pkl
